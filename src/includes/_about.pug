//- ──────────────────────────────────────────
//- ABOUT (shared: homepage + shop)
//- ──────────────────────────────────────────
section#about.about
  h2.section-title(data-i18n='about.title')= t('about.title')
  .about__inner
    //- Column 1: presentation
    .about__intro
      p(data-i18n='about.p1')= t('about.p1')
      p(data-i18n='about.p2')= t('about.p2')
    //- Column 2: why choose
    .about__why
      h3.subsection-title.about__subtitle
        span(data-i18n='about.why.prefix')= t('about.why.prefix')
        span.brand-name Atelier Guillotine
        span(data-i18n='about.why.suffix')= t('about.why.suffix')
      .about__benefits
        each n in [1, 2, 3, 4]
          .about__benefit
            h4.about__benefit-title(data-i18n=('about.benefit' + n + '.title'))= t('about.benefit' + n + '.title')
            p.about__benefit-text(data-i18n=('about.benefit' + n + '.text'))= t('about.benefit' + n + '.text')
