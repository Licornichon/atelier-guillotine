//- ──────────────────────────────────────────
//- PRICING (shared: homepage + commissions page)
//- Needs priceRows: include includes/_price-grid first
//- ──────────────────────────────────────────
section#pricing.pricing
  h2.section-title(data-i18n='pricing.title')= t('pricing.title')

  .pricing__section.pricing__section--notice
    h3.pricing__subtitle(data-i18n='pricing.howWorks.title')= t('pricing.howWorks.title')
    p(data-i18n='pricing.howWorks.desc1')= t('pricing.howWorks.desc1')
    p(data-i18n='pricing.howWorks.desc2')= t('pricing.howWorks.desc2')
    p(data-i18n='pricing.howWorks.display')= t('pricing.howWorks.display')

  .pricing__section
    h3.pricing__subtitle(data-i18n='pricing.table.title')= t('pricing.table.title')
    .pricing__table-wrapper
      table.pricing__table
        thead
          tr
            th(scope='col' data-i18n='pricing.table.col.type')= t('pricing.table.col.type')
            th(scope='col' data-i18n='pricing.tr.name')= t('pricing.tr.name')
            th(scope='col' data-i18n='pricing.ttp.name')= t('pricing.ttp.name')
        tbody
          each row in priceRows
            tr
              td(data-i18n-html=row.key)!= t(row.key)
              td(
                data-i18n='pricing.priceFrom'
                data-i18n-vars=JSON.stringify({ price: row.tr })
                data-i18n-label='pricing.tr.name'
                data-label=t('pricing.tr.name')
              )= t('pricing.priceFrom', { price: row.tr })
              td(
                data-i18n='pricing.priceFrom'
                data-i18n-vars=JSON.stringify({ price: row.ttp })
                data-i18n-label='pricing.ttp.name'
                data-label=t('pricing.ttp.name')
              )= t('pricing.priceFrom', { price: row.ttp })
