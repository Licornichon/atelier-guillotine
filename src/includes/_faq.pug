//- ──────────────────────────────────────────
//- FAQ (shared — homepage + shop)
//- Questions = faq.q1 … faq.qN keys in the translations: bump faqCount when adding one
//- ──────────────────────────────────────────
- var faqCount = 10
section#faq.faq
  h2.faq__title(data-i18n='faq.title')= t('faq.title')
  .faq__inner
    p.faq__subtitle(data-i18n='faq.subtitle')= t('faq.subtitle')
    .faq__list
      - for (var n = 1; n <= faqCount; n++)
        .faq__item
          h3.faq__question(data-i18n=('faq.q' + n + '.title'))= t('faq.q' + n + '.title')
          p.faq__answer(data-i18n=('faq.q' + n + '.answer'))= t('faq.q' + n + '.answer')
