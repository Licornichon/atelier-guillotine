//- ──────────────────────────────────────────
//- FAQ (shared: homepage + shop)
//- Questions = faq.q1 … faq.qN keys in the translations: bump faqCount when adding one
//- ──────────────────────────────────────────
- var faqCount = 6
section#faq.faq
  h2.section-title.faq__title(data-i18n='faq.title')= t('faq.title')
  .faq__inner
    .faq__list
      - for (var n = 1; n <= faqCount; n++)
        //- Mobile accordion: the button opens / closes the answer (faq.js)
        .faq__item
          h3.faq__question
            button.faq__toggle(
              type='button'
              aria-expanded='false'
              aria-controls=('faq-answer-' + n)
              data-i18n=('faq.q' + n + '.title')
            )= t('faq.q' + n + '.title')
          p.faq__answer(id=('faq-answer-' + n) data-i18n=('faq.q' + n + '.answer'))= t('faq.q' + n + '.answer')
