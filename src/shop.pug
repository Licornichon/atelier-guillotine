doctype html
- var page = 'shop'
html(lang='fr' data-page=page)
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description' data-i18n-content='shop.meta.description' content=t('shop.meta.description'))
    title(data-i18n='shop.meta.title')= t('shop.meta.title')
    link(rel='canonical' href=siteUrl + '/shop')
    //- Open Graph — hardcoded French: scrapers never run the i18n JS
    meta(property='og:type' content='website')
    meta(property='og:site_name' content='Atelier Guillotine')
    meta(property='og:locale' content='fr_FR')
    meta(property='og:url' content=siteUrl + '/shop')
    meta(property='og:title' content='Boutique — Atelier Guillotine | Figurines peintes à vendre')
    meta(property='og:description' content='Figurines peintes actuellement en vente — pièces d’exposition et niveau jeu pour Warhammer et autres jeux de figurines.')
    meta(property='og:image' content=siteUrl + '/assets/media/og.jpg')
    meta(property='og:image:width' content='1200')
    meta(property='og:image:height' content='630')
    meta(property='og:image:alt' content='Figurines peintes par Atelier Guillotine')
    //- Favicons & PWA
    link(rel='icon' type='image/png' sizes='16x16' href='./assets/media/favicon/favicon-16.png')
    link(rel='icon' type='image/png' sizes='32x32' href='./assets/media/favicon/favicon-32.png')
    link(rel='icon' type='image/png' sizes='96x96' href='./assets/media/favicon/favicon-96.png')
    link(rel='icon' type='image/png' sizes='192x192' href='./assets/media/favicon/favicon-192.png')
    link(rel='apple-touch-icon' sizes='180x180' href='./assets/media/favicon/favicon-180.png')
    link(rel='manifest' href='./assets/media/favicon/site.webmanifest')
  body
    include includes/_nav
    include includes/_hero

    +nav(page)

    main#main-content

      //- ──────────────────────────────────────────
      //- HERO
      //- ──────────────────────────────────────────
      +hero({
        id: 'shop-hero',
        title: 'shop.hero.title',
        subtitle: 'shop.hero.subtitle',
        left: { src: './assets/media/hero/etheldin.png', altKey: 'hero.alt.etheldin' },
        right: { src: './assets/media/hero/machaon.png', altKey: 'hero.alt.machaon' },
      })

      //- ──────────────────────────────────────────
      //- ITEMS FOR SALE
      //- Generated from assets/media/shop/<slug>/ (info.json + images)
      //- ──────────────────────────────────────────
      section#shop.shop
        h2.shop__title(data-i18n='shop.title')= t('shop.title')
        if shopItems && shopItems.length
          - var shopI18nMap = shopItems.reduce(function (m, it) { m[it.slug] = it.i18n; return m }, {})
          script#shop-i18n-data(type='application/json').
            !{JSON.stringify(shopI18nMap).replace(/</g, '\\u003c')}
          ul.shop__list
            each item in shopItems
              - var loc = item.i18n.fr.name ? item.i18n.fr : item.i18n.en
              li.shop__item(class=('shop__item--' + item.status))
                .shop__media
                  a.shop__photo(href=item.images[0] data-shop-gallery=item.slug)
                    img(src=item.images[0] alt=loc.name data-shop-i18n-alt=(item.slug + '.name') loading='lazy')
                  if item.images.length > 1
                    .shop__thumbs
                      each photo in item.images.slice(1)
                        a.shop__thumb(href=photo data-shop-gallery=item.slug)
                          img(src=photo alt='' loading='lazy')
                .shop__body
                  if loc.tag
                    span.shop__tag(data-shop-i18n=(item.slug + '.tag'))= loc.tag
                  h3.shop__name(data-shop-i18n=(item.slug + '.name'))= loc.name
                  .shop__meta
                    if item.level
                      span.shop__level(class=('shop__level--' + item.level) data-i18n=('shop.level.' + item.level))= t('shop.level.' + item.level)
                    span.shop__status(class=('shop__status--' + item.status) data-i18n=('shop.status.' + item.status))= t('shop.status.' + item.status)
                  if item.price
                    p.shop__price= item.price
                  if loc.description
                    p.shop__description(data-shop-i18n=(item.slug + '.description'))= loc.description
                  a.shop__cta(href='#contact' data-i18n='shop.item.cta')= t('shop.item.cta')
        else
          p.shop__empty(data-i18n='shop.empty')= t('shop.empty')

      //- ──────────────────────────────────────────
      //- Sections shared with the homepage (see src/includes/)
      //- ──────────────────────────────────────────
      - var contactSubject = "Shop enquiry — Atelier Guillotine"
      include includes/_contact

      include includes/_about

      include includes/_faq

    footer.footer
      span © #{new Date().getFullYear()} #[span.brand-name Atelier Guillotine]
      //- TODO — link hidden while legal.html is not generated (see webpack.config.js).
      //- Restore it together with the page.
      //- a.footer__link(href='./legal' data-i18n='footer.legal')= t('footer.legal')
