doctype html
- var page = 'shop'
html(lang=lang data-page=page)
  head
    include includes/_head
    +head(page)
  body
    include includes/_nav
    include includes/_hero

    +nav(page)

    main#main-content

      //- ──────────────────────────────────────────
      //- HERO
      //- ──────────────────────────────────────────
      +hero({
        id: 'shop-hero',
        title: 'shop.hero.title',
        subtitle: 'shop.hero.subtitle',
        left: { src: '/assets/generated/hero/voleur.webp', altKey: 'hero.alt.voleur' },
        right: { src: '/assets/generated/hero/machaon.webp', altKey: 'hero.alt.machaon' },
      })

      //- ──────────────────────────────────────────
      //- ITEMS FOR SALE
      //- Generated from assets/media/shop/<slug>/ (info.json + images)
      //- ──────────────────────────────────────────
      section#shop.shop
        h2.section-title(data-i18n='shop.title')= t('shop.title')
        if shopItems && shopItems.length
          ul.shop__list
            each item in shopItems
              //- Texts in the page language (generate-shop.js falls back on the other one)
              - var loc = item.i18n[lang]
              //- Grid areas (_shop.scss): head / media / body. Two columns: media on the
              //- left, head + body on the right. One column: head, media, body.
              li.shop__item(class=('shop__item--' + item.status))
                .shop__head
                  if loc.tag
                    span.shop__tag= loc.tag
                  h3.shop__name= loc.name
                  .shop__meta
                    if item.level
                      span.shop__level(class=('shop__level--' + item.level) data-i18n=('shop.level.' + item.level))= t('shop.level.' + item.level)
                    span.shop__status(class=('shop__status--' + item.status) data-i18n=('shop.status.' + item.status))= t('shop.status.' + item.status)
                  if item.price || item.retailPrice
                    .shop__pricing
                      //- Bare numbers in info.json: shop.price carries the euro sign,
                      //- which sits before the amount in English and after it in French
                      if item.price
                        p.shop__price(
                          data-i18n='shop.price'
                          data-i18n-vars=JSON.stringify({ price: item.price })
                        )= t('shop.price', { price: item.price })
                      //- Retail price of the bare models, to set apart the painting work
                      if item.retailPrice
                        p.shop__retail
                          span(data-i18n='shop.item.retail')= t('shop.item.retail')
                          |  
                          span(
                            data-i18n='shop.price'
                            data-i18n-vars=JSON.stringify({ price: item.retailPrice })
                          )= t('shop.price', { price: item.retailPrice })
                .shop__media
                  //- Photos = resized WebP copies (npm run generate): src/srcset, full, thumb
                  - var cover = item.images[0]
                  //- Main photo: opens the piece's full-screen gallery at the photo shown (lightbox.js)
                  a.shop__photo(href=cover.full data-shop-images=JSON.stringify(item.images.map(function (im) { return im.full })))
                    img(
                      src=cover.src
                      srcset=cover.srcset
                      sizes='(max-width: 1024px) 100vw, 720px'
                      width=cover.width
                      height=cover.height
                      alt=loc.name
                      loading='lazy'
                    )
                  //- Thumbnails (every photo, first included): show the picked one in the main slot (shop.js)
                  if item.images.length > 1
                    //- --thumb-cols: columns of the mobile thumbnail grid (max 6 per row)
                    .shop__thumbs(style=('--thumb-cols: ' + Math.min(item.images.length, 6)))
                      each photo, i in item.images
                        button.shop__thumb(
                          type='button'
                          class=(i === 0 ? 'is-active' : undefined)
                          data-src=photo.src
                          data-srcset=photo.srcset
                          data-width=photo.width
                          data-height=photo.height
                          data-full=photo.full
                          aria-pressed=(i === 0 ? 'true' : 'false')
                          aria-label=t('shop.item.thumb')
                          data-i18n-aria='shop.item.thumb'
                        )
                          img(src=photo.thumb alt='' loading='lazy')
                .shop__body
                  if loc.description
                    p.shop__description= loc.description
                  //- Button wording follows the status: buy it, or be told if it frees up
                  - var ctaKey = item.status === 'reserved' ? 'shop.item.ctaReserved' : 'shop.item.cta'
                  a.cta.shop__cta(href='#contact' data-i18n-html=ctaKey)!= t(ctaKey)
        else
          p.shop__empty(data-i18n='shop.empty')= t('shop.empty')

      //- ──────────────────────────────────────────
      //- Sections shared with the homepage (see src/includes/)
      //- ──────────────────────────────────────────
      - var contactSubject = "Shop enquiry | Atelier Guillotine"
      - var contactTitleKey = 'contact.shop.title'
      - var contactPlaceholderKey = 'contact.shop.messagePlaceholder'
      include includes/_contact

      include includes/_about

      include includes/_faq

    footer.footer
      span © #{new Date().getFullYear()} #[span.brand-name Atelier Guillotine]
      //- TODO: link hidden while legal.html is not generated (see webpack.config.js).
      //- Restore it together with the page.
      //- a.footer__link(href='./legal' data-i18n='footer.legal')= t('footer.legal')
