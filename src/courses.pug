doctype html
- var page = 'courses'
html(lang=lang data-page=page)
  head
    include includes/_head
    +head(page)
  body
    include includes/_nav
    include includes/_hero

    +nav(page)

    main#main-content

      //- ──────────────────────────────────────────
      //- HERO
      //- ──────────────────────────────────────────
      +hero({
        id: 'courses-hero',
        title: 'courses.hero.title',
        subtitle: 'courses.hero.subtitle',
        left: { src: '/assets/generated/hero/hommesbetes.webp', altKey: 'hero.alt.hommesbetes' },
        right: { src: '/assets/generated/hero/pirate.webp', altKey: 'hero.alt.pirate' },
      })

      //- ──────────────────────────────────────────
      //- METHOD: theory, demonstration, then guided practice
      //- ──────────────────────────────────────────
      section#courses-method.courses-method
        h2.section-title(data-i18n='courses.method.title')= t('courses.method.title')

        //- Introduction: how a lesson is set up and how to book one on the left,
        //- what to bring framed on the right (below on mobile)
        //- data-i18n-html: the paragraphs emphasise a few words
        .courses-method__intro
          .courses-method__text
            each n in [1, 3]
              p(data-i18n-html=('courses.method.p' + n))!= t('courses.method.p' + n)
          aside.courses-method__notice
            p(data-i18n-html='courses.method.p2')!= t('courses.method.p2')

        ol.courses-method__steps.steps
          each n in [1, 2, 3]
            - var s = 'courses.method.step' + n + '.'
            li.steps__item
              //- The <ol> already carries the order, the figure is decoration
              span.steps__number(aria-hidden='true')= n
              .steps__body
                h3.steps__title(data-i18n=(s + 'title'))= t(s + 'title')
                p.steps__text(data-i18n=(s + 'text'))= t(s + 'text')

        //- What can be worked on: a heading, then one line per point
        .courses-method__block
          h3.subsection-title(data-i18n='courses.topics.title')= t('courses.topics.title')
          ul.bullet-list
            - var itemKeys = []
            - for (var i = 1; i <= 9; i++) itemKeys.push('courses.topics.i' + i + '.')
            each k in itemKeys
              li
                strong(data-i18n=(k + 'label'))= t(k + 'label')
                span(data-i18n='list.sep')= t('list.sep')
                span(data-i18n=(k + 'text'))= t(k + 'text')

        .courses-method__footer
          a.cta(href='#contact' data-i18n-html='courses.cta')!= t('courses.cta')

      //- ──────────────────────────────────────────
      //- RATES. Solo prices per duration; the pair and small-group columns are
      //- that price less the discount. Reuses the .pricing__table component.
      //- ──────────────────────────────────────────
      - var courseRates = [{ hours: 1, solo: 40 }, { hours: 3, solo: 100 }, { hours: 6, solo: 180 }]
      //- off = discount in %, taken off the solo price of the same row
      - var courseGroups = [{ key: 'courses.rates.col.solo', off: 0 }, { key: 'courses.rates.col.duo', off: 10 }, { key: 'courses.rates.col.small', off: 30 }]
      section#courses-rates.pricing
        h2.section-title(data-i18n='courses.rates.title')= t('courses.rates.title')

        .pricing__section
          .pricing__table-wrapper
            table.pricing__table.pricing__table--even
              thead
                tr
                  th(scope='col' data-i18n='courses.rates.col.duration')= t('courses.rates.col.duration')
                  each g in courseGroups
                    th(scope='col' data-i18n=g.key)= t(g.key)
              tbody
                each row in courseRates
                  tr
                    td(
                      data-i18n='courses.rates.hours'
                      data-i18n-vars=JSON.stringify({ hours: row.hours })
                    )= t('courses.rates.hours', { hours: row.hours })
                    each g in courseGroups
                      - var amount = Math.round(row.solo * (1 - g.off / 100))
                      td(data-i18n-label=g.key data-label=t(g.key))
                        //- Group columns: the price paid, then the unit it applies to
                        span(
                          data-i18n='courses.price'
                          data-i18n-vars=JSON.stringify({ price: amount })
                        )= t('courses.price', { price: amount })
                        if g.off
                          span.pricing__price-note(data-i18n='courses.rates.perPerson')= t('courses.rates.perPerson')

        //- Below the table, as on the commissions page (see includes/_pricing.pug)
        .pricing__section.pricing__section--notice
          h3.subsection-title(data-i18n='courses.rates.coverTitle')= t('courses.rates.coverTitle')
          p(data-i18n='courses.rates.intro')= t('courses.rates.intro')
          p(data-i18n='courses.rates.note')= t('courses.rates.note')
          p(data-i18n='courses.rates.groups')= t('courses.rates.groups')

      //- ──────────────────────────────────────────
      //- Sections shared with the other pages (see src/includes/)
      //- ──────────────────────────────────────────
      - var contactSubject = "Lesson enquiry | Atelier Guillotine"
      - var contactTitleKey = 'contact.courses.title'
      - var contactPlaceholderKey = 'contact.courses.messagePlaceholder'
      include includes/_contact

      include includes/_about

    footer.footer
      span © #{new Date().getFullYear()} #[span.brand-name Atelier Guillotine]
      //- TODO: link hidden while legal.html is not generated (see webpack.config.js).
      //- Restore it together with the page.
      //- a.footer__link(href='./legal' data-i18n='footer.legal')= t('footer.legal')
