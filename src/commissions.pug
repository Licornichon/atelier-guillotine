doctype html
- var page = 'commissions'
html(lang=lang data-page=page)
  head
    include includes/_head
    +head(page)
  body
    include includes/_nav
    include includes/_hero

    +nav(page)

    main#main-content

      //- ──────────────────────────────────────────
      //- HERO
      //- ──────────────────────────────────────────
      +hero({
        id: 'commissions-hero',
        title: 'commissions.hero.title',
        subtitle: 'commissions.hero.subtitle',
        left: { src: '/assets/generated/hero/etheldin.webp', altKey: 'hero.alt.etheldin' },
        right: { src: '/assets/generated/hero/custodes-hero.webp', altKey: 'hero.alt.custodes' },
      })

      //- ──────────────────────────────────────────
      //- COMMISSIONS (texts = commissions.<id>.* keys, the amount in commissions.price
      //- = first row of the price grid)
      //- ──────────────────────────────────────────
      include includes/_price-grid
      //- feats = how many commissions.<id>.fN keys the card lists
      - var commissions = [
      -   { id: 'tr',      from: priceRows[0].tr, feats: 4 },
      -   { id: 'ttp',     from: priceRows[0].ttp, mod: 'commission--bestseller', feats: 7, tag: true },
      -   { id: 'display', mod: 'commission--featured', feats: 7 },
      - ]
      section#commissions.commissions
        h2.section-title(data-i18n='commissions.title')= t('commissions.title')
        .commissions__grid
          each c in commissions
            - var k = 'commissions.' + c.id + '.'
            .commission(class=c.mod)
              //- data-i18n goes on the spans, not the badge: lang.js writes
              //- textContent and would wipe the children
              .commission__badge
                span(data-i18n=(k + 'name'))= t(k + 'name')
                if c.tag
                  span.commission__tag(data-i18n=(k + 'tag'))= t(k + 'tag')
              if c.from
                .commission__price(
                  data-i18n='commissions.price'
                  data-i18n-vars=JSON.stringify({ price: c.from })
                )= t('commissions.price', { price: c.from })
              else
                .commission__price(data-i18n=(k + 'price'))= t(k + 'price')
              p.commission__description(data-i18n=(k + 'desc'))= t(k + 'desc')
              ul.commission__features.arrow-list
                - var featKeys = []
                - for (var i = 1; i <= c.feats; i++) featKeys.push(k + 'f' + i)
                each fk in featKeys
                  li(data-i18n=fk)= t(fk)
        .commissions__footer
          a.cta(href='#contact' data-i18n-html='commissions.cta')!= t('commissions.cta')

      include includes/_pricing

      //- ──────────────────────────────────────────
      //- HOW A COMMISSION WORKS: 7 steps, commissions.order.* keys
      //- ──────────────────────────────────────────
      section#order.commission-order
        h2.section-title(data-i18n='commissions.order.title')= t('commissions.order.title')
        ol.commission-order__steps.steps
          each n in [1, 2, 3, 4, 5, 6, 7]
            - var s = 'commissions.order.step' + n + '.'
            li.steps__item
              //- The <ol> already carries the order, the figure is decoration
              span.steps__number(aria-hidden='true')= n
              .steps__body
                h3.steps__title(data-i18n=(s + 'title'))= t(s + 'title')
                p.steps__text(data-i18n=(s + 'text'))= t(s + 'text')

      //- ──────────────────────────────────────────
      //- Sections shared with the homepage (see src/includes/)
      //- ──────────────────────────────────────────
      include includes/_faq

      include includes/_contact

      include includes/_about

    include includes/_footer
