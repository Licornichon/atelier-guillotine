doctype html
- var page = 'commissions'
html(lang='fr' data-page=page)
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description' data-i18n-content='commissions.meta.description' content=t('commissions.meta.description'))
    title(data-i18n='commissions.meta.title')= t('commissions.meta.title')
    link(rel='canonical' href=siteUrl + '/commissions')
    //- Open Graph, hardcoded in French: scrapers never run the i18n JS
    meta(property='og:type' content='website')
    meta(property='og:site_name' content='Atelier Guillotine')
    meta(property='og:locale' content='fr_FR')
    meta(property='og:url' content=siteUrl + '/commissions')
    meta(property='og:title' content='Prestations | Atelier Guillotine | Peinture de figurines sur commande')
    meta(property='og:description' content='Trois niveaux de peinture de figurines sur commande : Battle Ready, Tabletop+ et Display.')
    meta(property='og:image' content=siteUrl + '/assets/media/og.jpg')
    meta(property='og:image:width' content='1200')
    meta(property='og:image:height' content='630')
    meta(property='og:image:alt' content='Figurines peintes par Atelier Guillotine')
    //- Favicons & PWA
    link(rel='icon' type='image/png' sizes='16x16' href='./assets/media/favicon/favicon-16.png')
    link(rel='icon' type='image/png' sizes='32x32' href='./assets/media/favicon/favicon-32.png')
    link(rel='icon' type='image/png' sizes='96x96' href='./assets/media/favicon/favicon-96.png')
    link(rel='icon' type='image/png' sizes='192x192' href='./assets/media/favicon/favicon-192.png')
    link(rel='apple-touch-icon' sizes='180x180' href='./assets/media/favicon/favicon-180.png')
    link(rel='manifest' href='./assets/media/favicon/site.webmanifest')
  body
    include includes/_nav
    include includes/_hero

    +nav(page)

    main#main-content

      //- ──────────────────────────────────────────
      //- HERO
      //- ──────────────────────────────────────────
      +hero({
        id: 'commissions-hero',
        title: 'commissions.hero.title',
        subtitle: 'commissions.hero.subtitle',
        left: { src: './assets/generated/hero/custodes-hero.webp', altKey: 'hero.alt.custodes' },
        right: { src: './assets/generated/hero/orc.webp', altKey: 'hero.alt.orc' },
      })

      //- ──────────────────────────────────────────
      //- COMMISSIONS (texts = commissions.<id>.* keys, "from X €" = first row of the price grid)
      //- ──────────────────────────────────────────
      include includes/_price-grid
      - var commissions = [
      -   { id: 'tr',      from: priceRows[0].tr },
      -   { id: 'ttp',     from: priceRows[0].ttp, mod: 'commission--bestseller' },
      -   { id: 'display', mod: 'commission--featured' },
      - ]
      section#commissions.commissions
        h2.commissions__title(data-i18n='commissions.title')= t('commissions.title')
        .commissions__grid
          each c in commissions
            - var k = 'commissions.' + c.id + '.'
            .commission(class=c.mod)
              .commission__badge(data-i18n=(k + 'name'))= t(k + 'name')
              if c.from
                .commission__price #[span(data-i18n='commissions.priceFrom') #{t('commissions.priceFrom')}] #{c.from}&nbsp;€ #[span(data-i18n='commissions.pricePer') #{t('commissions.pricePer')}]
              else
                .commission__price(data-i18n=(k + 'price'))= t(k + 'price')
              p.commission__description(data-i18n=(k + 'desc'))= t(k + 'desc')
              ul.commission__features
                each f in ['f1', 'f2', 'f3']
                  li(data-i18n=(k + f))= t(k + f)
              a.commission__cta(href='#contact' data-i18n=(k + 'cta'))= t(k + 'cta')

      include includes/_pricing

      //- ──────────────────────────────────────────
      //- Sections shared with the homepage (see src/includes/)
      //- ──────────────────────────────────────────
      include includes/_faq

      include includes/_contact

      include includes/_about

    footer.footer
      span © #{new Date().getFullYear()} #[span.brand-name Atelier Guillotine]
      //- TODO: link hidden while legal.html is not generated (see webpack.config.js).
      //- Restore it together with the page.
      //- a.footer__link(href='./legal' data-i18n='footer.legal')= t('footer.legal')
