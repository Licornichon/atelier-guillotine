//- ⚠️ TODO: the legal.* strings still hold placeholders (MEDIATEUR_NOM,
//- MEDIATEUR_SITE): replace them in translations.fr.js / translations.en.js.
//- No postal address on purpose for now (kept out of Sirène); LCEN and consumer
//- law expect one, add it to legal.editor.content once there is a business
//- address (domiciliation).
doctype html
- var page = 'legal'
html(lang=lang data-page=page)
  head
    include includes/_head
    +head(page)
    //- Kept out of search results (still reachable from the footer)
    meta(name='robots' content='noindex')
  body
    include includes/_nav

    +nav(page, { sharedSections: false })

    main#main-content.legal-page
      .legal-page__inner
        section.legal-page__section
          h1.legal-page__title(data-i18n='legal.title')= t('legal.title')
          p.legal-page__intro(data-i18n='legal.intro')= t('legal.intro')

        //- ── Legal notice (LCEN art. 6-III) ─────────────────────────────
        section.legal-page__section
          h2(data-i18n='legal.editor.title')= t('legal.editor.title')
          div(data-i18n-html='legal.editor.content')!= t('legal.editor.content')

        section.legal-page__section
          h2(data-i18n='legal.host.title')= t('legal.host.title')
          div(data-i18n-html='legal.host.content')!= t('legal.host.content')

        section.legal-page__section
          h2(data-i18n='legal.ip.title')= t('legal.ip.title')
          div(data-i18n-html='legal.ip.content')!= t('legal.ip.content')

        section.legal-page__section
          h2(data-i18n='legal.mediation.title')= t('legal.mediation.title')
          div(data-i18n-html='legal.mediation.content')!= t('legal.mediation.content')

        //- ── Terms of sale (CGV), #cgv anchor ───────────────────────────
        section#cgv.legal-page__section
          h2(data-i18n='legal.cgv.title')= t('legal.cgv.title')
          each id, i in ['scope', 'order', 'prices', 'payment', 'execution', 'delivery', 'withdrawal', 'warranty', 'photos', 'disputes']
            h3= (i + 1) + '. ' + t('legal.cgv.' + id + '.title')
            div!= t('legal.cgv.' + id + '.content')

        //- ── Personal data (GDPR), #personal-data anchor ───────────────
        section#personal-data.legal-page__section
          h2(data-i18n='legal.data.title')= t('legal.data.title')
          div(data-i18n-html='legal.data.content')!= t('legal.data.content')

        section.legal-page__section
          h2(data-i18n='legal.thirdParties.title')= t('legal.thirdParties.title')
          div(data-i18n-html='legal.thirdParties.content')!= t('legal.thirdParties.content')

        section.legal-page__section
          h2(data-i18n='legal.transfers.title')= t('legal.transfers.title')
          div(data-i18n-html='legal.transfers.content')!= t('legal.transfers.content')

        section.legal-page__section
          h2(data-i18n='legal.retention.title')= t('legal.retention.title')
          div(data-i18n-html='legal.retention.content')!= t('legal.retention.content')

        section.legal-page__section
          h2(data-i18n='legal.rights.title')= t('legal.rights.title')
          div(data-i18n-html='legal.rights.content')!= t('legal.rights.content')

        p.legal-page__updated(data-i18n='legal.updated')= t('legal.updated')

        a.legal-page__back(href='./' data-i18n='legal.back')= t('legal.back')

    include includes/_footer
